# David model and local-only endpoint
DAVID_MODEL=qwen2.5-coder:1.5b
DAVID_OLLAMA_URL=http://127.0.0.1:11434/api/chat

# Safety limits
DAVID_MAX_ITERATIONS=8
DAVID_COMMAND_TIMEOUT_SEC=45
DAVID_ALLOWED_COMMANDS=python,pytest
DAVID_MAX_FILE_WRITE_BYTES=250000
DAVID_MAX_TOTAL_WRITE_BYTES=1000000
DAVID_MAX_COMMAND_OUTPUT_CHARS=8000
DAVID_PLAN_QUALITY_THRESHOLD=0

# Paths (relative to project root)
DAVID_WORKSPACE_DIR=workspace
DAVID_MEMORY_DIR=memory
DAVID_MEMORY_FILE=long_term.json
DAVID_LOGS_DIR=logs

# Model sampling
DAVID_TEMPERATURE=0.2
